# =============================================
# Supabase – Project URL
# Settings → General → Project URL
# =============================================
NEXT_PUBLIC_SUPABASE_URL=https://IHRE-PROJEKT-ID.supabase.co

# =============================================
# Supabase – Publishable Key (ersetzt früher "anon key")
# Settings → API Keys → "Publishable key" → Zeile "default"
# Format: sb_publishable_...
# =============================================
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# =============================================
# Supabase – Secret Key (ersetzt früher "service_role key")
# Settings → API Keys → "Secret keys" → Zeile "default" → Auge-Symbol klicken!
# Format: sb_secret_...
# ACHTUNG: Niemals ins Frontend – nur serverseitig!
# =============================================
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# =============================================
# App-URL (für Links in E-Mails)
# Lokal: http://localhost:3000
# Produktiv: https://ihre-app.vercel.app
# =============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================
# E-Mail via Resend (optional)
# Konto erstellen: https://resend.com (3.000 E-Mails/Monat gratis)
# =============================================
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@ihre-domain.de
ADMIN_EMAIL=ihre@email.de

# =============================================
# Cron-Job Absicherung (beliebiger geheimer String, mind. 20 Zeichen)
# =============================================
CRON_SECRET=ein-langer-zufaelliger-geheimer-string
