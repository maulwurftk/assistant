# ============================================================================
# Assistenten-App · Umgebungsvariablen
# Kopiere diese Datei zu ".env.local" (lokal) bzw. trage die Werte in den
# Environment-Variablen deiner Hosting-Plattform (z.B. Vercel) ein.
# ============================================================================

# ── PFLICHT: Supabase ───────────────────────────────────────────────────────
# Findest du im Supabase-Projekt unter: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=DEIN_ANON_PUBLIC_KEY
# Der Service-Role-Key ist GEHEIM – niemals im Client/Repo veröffentlichen!
SUPABASE_SERVICE_ROLE_KEY=DEIN_SERVICE_ROLE_KEY

# ── PFLICHT: App-Adresse ────────────────────────────────────────────────────
# Die öffentliche URL deiner Instanz (ohne Slash am Ende).
# Wird in E-Mail-Links und im Kalender-Feed verwendet.
NEXT_PUBLIC_APP_URL=https://deine-instanz.example.com

# ── PUSH-Benachrichtigungen (empfohlen) ─────────────────────────────────────
# VAPID-Schlüsselpaar EINMALIG erzeugen:  npx web-push generate-vapid-keys
# Der Public Key ist NEXT_PUBLIC_ (muss nach dem Setzen neu deployed werden!).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt-Adresse für Push (mailto: davor, z.B. mailto:admin@example.com)
VAPID_EMAIL=mailto:admin@example.com

# ── Automatische Erinnerungen (empfohlen) ───────────────────────────────────
# Frei wählbares Geheimnis. Der Cron/Scheduler ruft die Erinnerungs-Routen
# mit  Authorization: Bearer <CRON_SECRET>  auf.
CRON_SECRET=EIN_LANGES_ZUFALLSGEHEIMNIS

# ── E-Mail-Versand (optional) ───────────────────────────────────────────────
# Ohne diese Werte läuft die App auch – dann gibt es nur In-App- & Push-
# Benachrichtigungen, aber keinen E-Mail-Versand (Lohnzettel/Erinnerungen).
# Konto bei https://resend.com anlegen, Domain verifizieren.
RESEND_API_KEY=
FROM_EMAIL=noreply@deine-domain.de
# Adresse, an die Admin-Hinweise (z.B. neuer Monatsbericht) gehen.
ADMIN_EMAIL=

# ── Externer Google-Kalender im Admin-Kalender anzeigen (optional) ──────────
# Öffentliche iCal-URL eines Google-Kalenders, die im Admin-Kalender
# eingeblendet wird. Leer lassen, wenn nicht gewünscht.
GOOGLE_CALENDAR_ICAL_URL=
