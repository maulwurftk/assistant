{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "next build --webpack",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/remind-open-slots",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/send-monthly-reminders",
      "schedule": "0 8 28-31 * *"
    }
  ]
}
